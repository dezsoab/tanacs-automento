---
import { Image } from "astro:assets";
import { PHONE, PHONE_HREF, stats } from "../data/site";
import { photos } from "../data/photos";
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-[#0a0a0a]">
    <Image
      src={photos.ejszakaiAutomentes}
      alt="Éjszakai autómentés: megrakott platós vontató bekapcsolt figyelmeztető fényekkel"
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover opacity-35"
    />
    <div
      class="absolute inset-0 bg-linear-to-r from-[#0f0f0f] via-[#0f0f0f]/70 to-transparent"
    >
    </div>
  </div>

  <div
    class="relative z-10 max-w-7xl mx-auto px-5 py-24 grid md:grid-cols-2 gap-12 items-center"
  >
    <div>
      <div
        class="inline-flex items-center gap-2 bg-orange-600/20 border border-orange-500/40 text-orange-400 text-xs font-bold tracking-widest uppercase px-3 py-1.5 rounded mb-6"
      >
        <span class="beacon inline-block w-1.5 h-1.5 rounded-full bg-orange-400"
        ></span>
        Napi 24 órában, heti 7 napon elérhető
      </div>

      <h1
        class="font-display text-5xl md:text-6xl lg:text-7xl font-black leading-[1.0] mb-6 text-white"
      >
        Bajban van?<br />
        <span class="text-orange-500">Már úton</span><br />
        vagyunk.
      </h1>

      <p class="text-white/70 text-lg leading-relaxed mb-10 max-w-md">
        Gyors, megbízható autómentés és vontatás az egész térségben. Azonnal
        felvesszük a telefont – nincs gép, nincs várakozás.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={PHONE_HREF}
          class="pulse-cta flex items-center justify-center gap-3 bg-orange-600 hover:bg-orange-500 text-white font-display font-bold text-xl py-5 px-8 rounded transition-colors"
        >
          <span class="text-2xl">📞</span>
          <div class="text-left">
            <div
              class="text-xs font-body font-normal opacity-80 tracking-wider"
            >
              HÍVJON MOST
            </div>
            <div>{PHONE}</div>
          </div>
        </a>
        <a
          href="#services"
          class="flex items-center justify-center gap-2 border border-white/30 hover:border-white text-white font-semibold py-5 px-8 rounded transition-colors text-sm"
        >
          Szolgáltatásaink ↓
        </a>
      </div>

      <p class="mt-5 text-white/40 text-xs tracking-wide">
        Átlagos kiérkezési idő: <span class="text-orange-400 font-bold"
          >28 perc</span
        > vagy kevesebb
      </p>
    </div>

    <div class="hidden md:grid grid-cols-2 gap-3">
      {
        stats.map((s) => (
          <div class="bg-white/5 border border-white/10 rounded-lg p-6">
            <div class="font-display font-black text-4xl text-orange-500 mb-1">
              {s.value}
            </div>
            <div class="text-white/60 text-sm">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
