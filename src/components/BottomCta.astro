---
import { Image } from "astro:assets";
import { PHONE, PHONE_HREF } from "../data/site";
import { photos } from "../data/photos";
---

<section class="relative bg-[#111] py-24 px-5 overflow-hidden">
  <div class="absolute inset-0">
    <Image
      src={photos.havasAutoVontaton}
      alt=""
      widths={[800, 1600]}
      sizes="100vw"
      class="w-full h-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-linear-to-b from-[#111] via-[#111]/80 to-[#111]"></div>
  </div>
  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <p class="text-orange-500 text-xs font-bold tracking-widest uppercase mb-4">Ne várjon</p>
    <h2 class="font-display font-black text-4xl md:text-6xl text-white mb-6 leading-tight">
      Bajban van? Hívjon most.<br />Ott leszünk.
    </h2>
    <p class="text-white/60 mb-10 text-lg">
      Egyetlen hívással élő diszpécserhez kapcsolódik, aki azonnal a legközelebbi járművet küldi.
    </p>
    <a
      href={PHONE_HREF}
      class="pulse-cta inline-flex items-center justify-center gap-4 bg-orange-600 hover:bg-orange-500 text-white font-display font-black text-2xl md:text-3xl py-6 px-10 rounded-lg transition-colors"
    >
      <span class="text-3xl">📞</span>
      {PHONE}
    </a>
    <p class="mt-5 text-white/35 text-sm">0–24 fogadjuk a hívásokat · Átlagos kiérkezés: 28 perc</p>
  </div>
</section>
