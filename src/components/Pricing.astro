---
import { PHONE, PHONE_HREF, priceFactors } from "../data/site";
---

<section id="pricing" class="bg-[#0f0f0f] border-b border-white/10 py-24 px-5 scroll-mt-20">
  <div class="max-w-7xl mx-auto grid lg:grid-cols-5 gap-12 lg:gap-16 items-center">
    <div class="lg:col-span-2">
      <p class="text-orange-500 text-xs font-bold tracking-widest uppercase mb-3">Árak</p>
      <h2 class="font-display font-black text-4xl md:text-5xl text-white leading-tight mb-6">
        Mennyibe kerül a mentés?
      </h2>
      <p class="text-white/65 text-lg leading-relaxed mb-8">
        Az ár több tényezőtől függ, ezért nincs egységes tarifánk. Pontos árat a részleteket
        megbeszélve, telefonon tudunk adni.
      </p>
      <a
        href={PHONE_HREF}
        class="inline-flex items-center gap-3 bg-orange-600 hover:bg-orange-500 text-white font-bold py-4 px-7 rounded transition-colors"
      >
        📞 Árajánlat telefonon: {PHONE}
      </a>
    </div>

    <ol class="lg:col-span-3 grid sm:grid-cols-2 gap-4">
      {
        priceFactors.map((f, i) => (
          <li class="bg-[#1a1a1a] border border-white/8 rounded-lg p-6">
            <div class="font-display font-black text-3xl text-orange-500 mb-3">
              {String(i + 1).padStart(2, "0")}
            </div>
            <h3 class="font-display font-bold text-xl text-white mb-2">{f.title}</h3>
            <p class="text-white/55 text-sm leading-relaxed">{f.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
