---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { services } from "../data/site";
---

<section id="services" class="bg-[#111] py-24 px-5 scroll-mt-20">
  <div class="max-w-7xl mx-auto">
    <SectionHeading eyebrow="Amit csinálunk">
      Teljes körű segítség,<br />minden helyzetben
    </SectionHeading>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        services.map((s) => (
          <div class="group bg-[#1a1a1a] border border-white/8 rounded-lg overflow-hidden hover:border-orange-500/50 transition-colors">
            <div class="relative h-48 bg-[#2a2a2a] overflow-hidden">
              <Image
                src={s.img}
                alt={s.alt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-linear-to-t from-[#1a1a1a] to-transparent" />
            </div>
            <div class="p-6">
              <h3 class="font-display font-bold text-xl text-white mb-2">{s.title}</h3>
              <p class="text-white/55 text-sm leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
