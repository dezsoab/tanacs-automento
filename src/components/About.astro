---
import { Image } from "astro:assets";
import { PHONE, PHONE_HREF, whyUs } from "../data/site";
import { photos } from "../data/photos";
---

<section id="about" class="bg-[#111] py-24 px-5 scroll-mt-20">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-center">
    <div class="relative rounded-lg overflow-hidden bg-[#2a2a2a] aspect-[4/3]">
      <Image
        src={photos.egyteruAutoVontaton}
        alt="Fehér egyterű autó a platós vontatón"
        widths={[600, 1000]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="w-full h-full object-cover"
      />
      <div
        class="absolute inset-0 bg-linear-to-tr from-orange-600/30 to-transparent"
      >
      </div>
      <div
        class="absolute top-5 left-5 bg-orange-600 text-white font-bold text-sm py-2 px-4 rounded"
      >
        Minden órában az utakon
      </div>
    </div>

    <div>
      <p
        class="text-orange-500 text-xs font-bold tracking-widest uppercase mb-4"
      >
        Miért a Tanács Autómentő?
      </p>
      <h2
        class="font-display font-black text-4xl md:text-5xl text-white leading-tight mb-6"
      >
        A csapat, amely ott van, amikor számít
      </h2>
      <p class="text-white/65 leading-relaxed mb-8">
        A Tanács Autómentő a régió legmegbízhatóbb mentőszolgálata. Több
        járműből álló flottával és minősített autómentőkkel dolgozunk,
        éjjel-nappal. Nincs robot, nincs körülményeskedés. Csak gyors, profi
        segítség, amikor a leginkább szüksége van rá.
      </p>

      <ul class="space-y-4">
        {
          whyUs.map((item) => (
            <li class="flex items-start gap-3 text-sm text-white/75">
              <span class="text-orange-500 mt-0.5 text-base shrink-0">✓</span>
              {item}
            </li>
          ))
        }
      </ul>

      <a
        href={PHONE_HREF}
        class="mt-10 inline-flex items-center gap-3 bg-orange-600 hover:bg-orange-500 text-white font-bold py-4 px-7 rounded transition-colors"
      >
        📞 Hívjon: {PHONE}
      </a>
    </div>
  </div>
</section>
